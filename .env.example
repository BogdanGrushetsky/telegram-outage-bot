# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/power-outage-bot?retryWrites=true&w=majority

# API Configuration
API_PORT=4010
HEALTH_CHECK_PORT=4010

# Scheduler Configuration
SCHEDULE_UPDATE_INTERVAL=900000

# Node Environment
NODE_ENV=production
